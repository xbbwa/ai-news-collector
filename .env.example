# Copy to .env and adjust.

# SQLite for a start; switch to PostgreSQL later, e.g.
# DATABASE_URL=postgresql+psycopg://collector:collector@localhost:5432/collector
DATABASE_URL=sqlite:///data/collector.db

# HTTP(S) or SOCKS5 proxy used for sources marked `proxy: true` in config/sources.yaml.
# Leave empty to go direct for everything.
PROXY_URL=http://127.0.0.1:7890

# Self-hosted RSSHub (see docker-compose.yml). Used to expand ${RSSHUB_URL} in sources.yaml.
RSSHUB_URL=http://localhost:1200

SOURCES_FILE=config/sources.yaml
REQUEST_TIMEOUT=20
FULLTEXT_CONCURRENCY=8
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
